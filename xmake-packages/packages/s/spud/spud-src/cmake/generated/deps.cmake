endmacro()

# Capstone links in as an OBJECT library, so its objects take the MSVC
# runtime of the parent build. CAPSTONE_BUILD_STATIC_MSVC_RUNTIME would
# force /MT and break /MD consumers.
macro(spud_provide_capstone)
  if(SPUD_AARCH64_SUPPORT AND NOT TARGET capstone)
    spud_dep_source_dir(capstone _spud_capstone_dir)
    set(CAPSTONE_BUILD_STATIC_LIBS ON)
    set(CAPSTONE_BUILD_SHARED_LIBS OFF)
    set(CAPSTONE_BUILD_STATIC_MSVC_RUNTIME OFF)
    set(CAPSTONE_BUILD_MACOS_THIN ON)
    set(CAPSTONE_ARCHITECTURE_DEFAULT OFF)
    set(CAPSTONE_AARCH64_SUPPORT ON)
    add_subdirectory("${_spud_capstone_dir}" capstone EXCLUDE_FROM_ALL)
  endif()
endmacro()

# Catch2 is about a hundred small sources that each parse the same
# headers; as one unity source it builds roughly ten times cheaper.
macro(spud_provide_catch2)
  if(NOT TARGET Catch2)
    spud_dep_source_dir(catch2 _spud_catch2_dir)
    add_subdirectory("${_spud_catch2_dir}" catch2 EXCLUDE_FROM_ALL)
    set_target_properties(Catch2 PROPERTIES UNITY_BUILD ON UNITY_BUILD_BATCH_SIZE 0)
  endif()
endmacro()
