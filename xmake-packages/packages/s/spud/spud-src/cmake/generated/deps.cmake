# Source tree for a pinned dep: vendor/ when scripts/fetch_vendor.sh has
# run, otherwise the same tarball, hash-checked, through FetchContent.
# SOURCE_SUBDIR points nowhere so FetchContent only unpacks; the caller
# adds the tree with its own options.
function(spud_dep_source_dir name out)
  string(TOUPPER "${name}" upper)
  set(vendor "${SPUD_VENDOR_DIR}/${SPUD_DEP_${upper}_VENDOR_DIR}")
  if(EXISTS "${vendor}/CMakeLists.txt")
    set(${out} "${vendor}" PARENT_SCOPE)
    return()
  endif()
  FetchContent_Declare(
    spud_${name}
    URL "${SPUD_DEP_${upper}_URL}"
    URL_HASH "SHA256=${SPUD_DEP_${upper}_SHA256}"
    SOURCE_SUBDIR "spud-populate-only"
  )
  FetchContent_MakeAvailable(spud_${name})
  set(${out} "${spud_${name}_SOURCE_DIR}" PARENT_SCOPE)
endfunction()

