@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

set_and_check(SPUD_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(SPUD_LIB_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

if(NOT TARGET spud::spud)
  add_library(spud::spud STATIC IMPORTED)
  set(_spud_location
      "${SPUD_LIB_DIR}/@SPUD_STATIC_LIB_FILENAME@")
  set(_spud_link
      "${SPUD_LIB_DIR}/@SPUD_ZYDIS_FILENAME@"
      "${SPUD_LIB_DIR}/@SPUD_ZYCORE_FILENAME@"
      Threads::Threads)
  if(WIN32)
    list(APPEND _spud_link psapi)
  endif()
  set_target_properties(
    spud::spud
    PROPERTIES
      IMPORTED_LOCATION "${_spud_location}"
      INTERFACE_INCLUDE_DIRECTORIES "${SPUD_INCLUDE_DIR}"
      INTERFACE_COMPILE_FEATURES "cxx_std_20"
      INTERFACE_COMPILE_DEFINITIONS
        "SPUD_DETOUR_TRACING=@SPUD_DETOUR_TRACING_VALUE@;SPUD_UNWIND_SUPPORT=@SPUD_UNWIND_SUPPORT_VALUE@"
      INTERFACE_LINK_LIBRARIES "${_spud_link}"
  )
  # Mirrors the PUBLIC option in CMakeLists.txt: the Windows headers need MS
  # extensions under GNU-style Clang.
  if(WIN32 AND CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND NOT MSVC)
    set_property(TARGET spud::spud PROPERTY INTERFACE_COMPILE_OPTIONS
      "$<$<COMPILE_LANG_AND_ID:CXX,Clang>:-fms-extensions>")
  endif()
  unset(_spud_location)
  unset(_spud_link)
endif()

check_required_components(spud)
